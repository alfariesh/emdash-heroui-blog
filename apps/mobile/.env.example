# Copy to apps/mobile/.env (never committed). EXPO_PUBLIC_* values are inlined
# into the JS bundle, so put only public values here: never a token or secret.

# Origin of apps/web (no trailing slash, no /api/v1). Leave unset in development
# to use the machine running Metro on port 4321 (see src/lib/config.ts).
# EXPO_PUBLIC_API_URL=https://blog.example.com

# Build-time app identity (read in app.config.ts).
# APP_NAME=Blog
# APP_ID=com.example.blog
# APP_SCHEME=blog
