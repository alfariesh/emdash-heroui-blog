{
	"name": "@blog/mobile",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"typegen": "expo customize tsconfig.json && uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts",
		"typecheck": "pnpm run typegen >/dev/null && tsc --noEmit",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
		"check-deps": "expo install --check",
		"doctor": "expo-doctor",
		"export": "expo export --platform android --platform ios"
	},
	"dependencies": {
		"@blog/shared": "workspace:*",
		"@expo-google-fonts/inter": "^0.4.2",
		"@hugeicons/core-free-icons": "^4.4.0",
		"@hugeicons/react-native": "^1.0.16",
		"@react-native-masked-view/masked-view": "0.3.2",
		"@shopify/flash-list": "2.3.2",
		"@tanstack/query-async-storage-persister": "^5.105.3",
		"@tanstack/react-query": "^5.105.3",
		"@tanstack/react-query-persist-client": "^5.105.3",
		"expo": "~58.0.22",
		"expo-blur": "~58.0.5",
		"expo-constants": "~58.0.14",
		"expo-device": "~58.0.5",
		"expo-font": "~58.0.11",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.18",
		"expo-linear-gradient": "~58.0.3",
		"expo-linking": "~58.0.15",
		"expo-network": "~58.0.4",
		"expo-notifications": "~58.1.8",
		"expo-router": "~58.0.29",
		"expo-splash-screen": "~58.0.12",
		"expo-sqlite": "~58.0.15",
		"expo-status-bar": "~58.0.4",
		"expo-system-ui": "~58.0.7",
		"expo-web-browser": "~58.0.7",
		"heroui-native": "^1.0.11",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.1",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-svg": "15.16.0",
		"react-native-web": "~0.21.4",
		"react-native-worklets": "0.13.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.4",
		"uniwind": "^1.13.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/react": "~19.3.0",
		"typescript": "^6.0.3"
	}
}
