# Copy to .env for local development. Never commit .env.

# Encrypts plugin secrets stored in the database. Generate one with:
#   npx emdash secrets generate
# Back it up: without it EmDash cannot decrypt stored secrets.
EMDASH_ENCRYPTION_KEY=

# Keep EMPTY for local development: it overrides the production value in
# wrangler.jsonc `vars`, so passkeys stay bound to localhost.
EMDASH_SITE_URL=

# Optional: test the app-link verification files locally (production values go
# in wrangler.jsonc `vars`; see src/lib/app-links.ts). Empty = 404.
# APP_LINKS_IOS_APP_IDS=ABCDE12345.com.example.blog
# APP_LINKS_ANDROID_PACKAGE=com.example.blog
# APP_LINKS_ANDROID_SHA256=AB:CD:...
