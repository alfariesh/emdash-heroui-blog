# Copy to .env for local development. Never commit .env.

# Encrypts plugin secrets stored in the database. Generate one with:
#   npx emdash secrets generate
# Back it up: without it EmDash cannot decrypt stored secrets.
EMDASH_ENCRYPTION_KEY=

# Public origin of the deployed site, e.g. https://blog.example.com
# Leave empty for local development (passkeys stay on localhost).
# In production set it where the site is built AND where it runs.
EMDASH_SITE_URL=
