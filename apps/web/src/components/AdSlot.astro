---
import type { InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import { cardVariants, cn } from "@heroui/styles";
import { AD_PLACEMENTS, type AdPlacement } from "../lib/ad-selection";

interface Props {
	ad?: InferCollectionData<"ads">;
	placement: AdPlacement;
	class?: string;
}

const { ad, placement, class: className } = Astro.props;
const isSidebar = placement === AD_PLACEMENTS.postSidebar;
// Page gutters + card inset; the article also reserves a 17rem rail and 3rem gap.
const imageSizes: Record<AdPlacement, string> = {
	[AD_PLACEMENTS.home]: "(min-width: 1152px) 1072px, (min-width: 1024px) calc(100vw - 5rem), (min-width: 640px) calc(100vw - 4rem), calc(100vw - 3rem)",
	[AD_PLACEMENTS.postSidebar]: "256px",
	[AD_PLACEMENTS.postBottom]: "(min-width: 1088px) 688px, (min-width: 1024px) calc(100vw - 25rem), (min-width: 640px) calc(100vw - 4rem), calc(100vw - 3rem)",
};
const card = cardVariants();
---

{
	ad && (
		<section class={className} aria-label="Iklan" data-ad-placement={placement}>
			<div class={cn(card.base(), "gap-2 rounded-3xl p-2 shadow-none")}>
				<p class="px-3 pt-1 text-xs text-muted">Iklan</p>
				<a
					href={ad.target_url}
					rel="sponsored"
					class="ad-banner relative block overflow-hidden rounded-2xl bg-surface-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
					style={{ aspectRatio: isSidebar ? "6 / 5" : "3 / 1" }}
				>
					<Image
						image={ad.image}
						alt={ad.image?.alt?.trim() || ad.title}
						sizes={imageSizes[placement]}
					/>
				</a>
			</div>
		</section>
	)
}

<style>
	.ad-banner :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
</style>
