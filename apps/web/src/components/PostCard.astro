---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import { cardVariants, chipVariants, cn } from "@heroui/styles";
import Byline from "./Byline.astro";
import { HugeiconsIcon } from "@hugeicons/react";
import { categoryIcon } from "../lib/icons";
import type { TermLink } from "../lib/post-terms";
import { formatDate, formatReadingTime, getReadingTime } from "@blog/shared";

interface Props {
	post: ContentEntry<InferCollectionData<"posts">>;
	tags?: TermLink[];
	/** Shown first with its icon; omit it on that category's own archive page. */
	category?: TermLink | null;
	/** card: grid tile. feature: large split card. row: archive list item. */
	variant?: "card" | "feature" | "row";
	headingLevel?: 2 | 3;
	/** Load the image eagerly; use for the largest image above the fold. */
	priority?: boolean;
}

const {
	post,
	tags = [],
	category = null,
	variant = "card",
	headingLevel = 2,
	priority = false,
} = Astro.props;

const Heading = `h${headingLevel}` as const;
const href = `/posts/${post.id}`;
const title = post.data.title || "Untitled";
const bylines = post.data.bylines ?? [];
const publishedAt = post.data.publishedAt ?? null;
const readingTime = formatReadingTime(getReadingTime(post.data.content));
// The category takes one of the chip slots so cards keep a single row
const maxChips = variant === "card" ? 2 : 3;
const visibleTags = tags.slice(0, maxChips - (category ? 1 : 0));

const card = cardVariants();
const chip = chipVariants({ size: "sm", variant: "soft" });
const categoryChip = chipVariants({ size: "sm", variant: "soft", color: "accent" });

const sizes = {
	card: "(min-width: 1024px) 360px, (min-width: 640px) 45vw, 100vw",
	feature: "(min-width: 1024px) 620px, 100vw",
	row: "(min-width: 640px) 220px, 100vw",
}[variant];

const layout = {
	card: "flex h-full flex-col",
	// minmax(0, …) stops the image's intrinsic width from widening the grid
	feature: "grid grid-cols-[minmax(0,1fr)] gap-0 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]",
	row: "grid grid-cols-[minmax(0,1fr)] gap-0 sm:grid-cols-[220px_minmax(0,1fr)]",
}[variant];

const mediaRatio = {
	card: "aspect-[16/10]",
	feature: "aspect-[16/10] md:aspect-auto md:min-h-[22rem]",
	row: "aspect-[16/10] sm:aspect-auto sm:h-full sm:min-h-[9.5rem]",
}[variant];

const titleClass = {
	card: "typography--h5",
	feature: "typography--h2",
	row: "typography--h4",
}[variant];
---

<article class={cn(card.base(), "post-card gap-0 p-2", layout)}>
	<a
		href={href}
		class={cn("media-frame rounded-2xl", mediaRatio)}
		tabindex="-1"
		aria-hidden="true"
		data-post-image={post.data.featured_image ? href : undefined}
	>
		{
			post.data.featured_image ? (
				<div class="h-full w-full" {...post.edit.featured_image}>
					<Image
						image={post.data.featured_image}
						sizes={sizes}
						priority={priority}
						class="post-card__image"
					/>
				</div>
			) : (
				<div class="h-full w-full bg-linear-to-br from-accent/15 via-surface-secondary to-surface-tertiary" />
			)
		}
	</a>

	<div
		class={cn(
			"flex flex-1 flex-col gap-3",
			variant === "feature" ? "p-4 sm:p-8 md:justify-center" : "p-3 pt-4",
			variant === "row" && "sm:p-5",
		)}
	>
		{
			(category || visibleTags.length > 0) && (
				<ul class="relative z-10 flex flex-wrap gap-1.5" aria-label="Categories and tags">
					{category && (
						<li>
							<a href={`/category/${category.slug}`} class={cn(categoryChip.base(), "pressable hover:opacity-80")}>
								<HugeiconsIcon icon={categoryIcon(category.slug)} size={12} strokeWidth={2} aria-hidden="true" />
								<span class={categoryChip.label()}>{category.label}</span>
							</a>
						</li>
					)}
					{visibleTags.map((tag) => (
						<li>
							<a href={`/tag/${tag.slug}`} class={cn(chip.base(), "pressable hover:opacity-80")}>
								<span class={chip.label()}>{tag.label}</span>
							</a>
						</li>
					))}
				</ul>
			)
		}

		<Heading class={cn("text-foreground text-balance", titleClass)}>
			<a
				href={href}
				class="post-card__link after:absolute after:inset-0 after:rounded-[inherit] focus-visible:outline-none"
				{...post.edit.title}
			>
				{title}
			</a>
		</Heading>

		{
			post.data.excerpt && (
				<p
					class={cn(
						"text-muted",
						variant === "feature" ? "typography--body line-clamp-3" : "typography--body-sm line-clamp-2",
					)}
					{...post.edit.excerpt}
				>
					{post.data.excerpt}
				</p>
			)
		}

		<div class="mt-auto pt-2">
			<Byline
				bylines={bylines}
				max={variant === "card" ? 1 : 2}
				avatars={variant === "card" ? 1 : 3}
				size="sm"
				readingTime={variant === "row" ? undefined : readingTime}
			>
				{variant !== "row" && publishedAt && (
					<p class="typography--body-xs text-muted tabular-nums">
						<time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, "short")}</time>
					</p>
				)}
			</Byline>
		</div>
	</div>
</article>

<style>
	/* The whole card is clickable via the title link; keep its focus ring on the card */
	article:has(h2 a:focus-visible, h3 a:focus-visible) {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}
</style>
