---
import type { ContentEntry, InferCollectionData } from "emdash";
import type { IconSvgElement } from "@hugeicons/react";
import type { TermLink } from "../lib/post-terms";
import PageIntro from "./PageIntro.astro";
import PostCard from "./PostCard.astro";
import Pagination from "./Pagination.astro";

interface Props {
	/** "Kategori" or "Tag" */
	eyebrow: string;
	title: string;
	description?: string | null;
	/** Category icon for the page header (tags have none) */
	icon?: IconSvgElement;
	basePath: string;
	posts: Array<{
		post: ContentEntry<InferCollectionData<"posts">>;
		tags: TermLink[];
		category?: TermLink | null;
	}>;
	cursor?: string;
	nextCursor?: string;
}

const { eyebrow, title, description, icon, basePath, posts, cursor, nextCursor } = Astro.props;
const countLabel = `${posts.length}${nextCursor ? "+" : ""} tulisan`;
---

<PageIntro eyebrow={eyebrow} title={title} description={description ?? countLabel} icon={icon} />

<section class="container-page">
	{
		posts.length > 0 ? (
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{posts.map(({ post, tags, category }) => (
					<PostCard post={post} tags={tags} category={category} variant="card" />
				))}
			</div>
		) : (
			<p class="rounded-3xl bg-surface px-6 py-16 text-center text-sm text-muted shadow-surface">
				Belum ada tulisan di sini.
			</p>
		)
	}
	<Pagination basePath={basePath} cursor={cursor} nextCursor={nextCursor} />
</section>
