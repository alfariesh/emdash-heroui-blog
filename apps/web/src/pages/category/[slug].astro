---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import TermArchive from "../../components/TermArchive.astro";
import { categoryIcon } from "../../lib/icons";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

// Single batched query for tags on every post in this category, rather
// than calling getEntryTerms() per post (which would be one round-trip
// per post).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title={`${term.label} — Category`} description={term.description ?? `Posts in ${term.label}`}>
	<TermArchive
		eyebrow="Category"
		title={term.label}
		description={term.description}
		icon={categoryIcon(term.slug)}
		basePath={`/category/${term.slug}`}
		posts={filteredPosts.map(({ post, tags }) => ({
			post,
			tags: tags.map((t) => ({ slug: t.slug, label: t.label })),
		}))}
		cursor={cursor}
		nextCursor={nextCursor}
	/>
</Base>
