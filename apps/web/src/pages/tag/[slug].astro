---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import TermArchive from "../../components/TermArchive.astro";
import { getPostTerms } from "../../lib/post-terms";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

// Tags + category for every post in two batched queries. The current tag is
// dropped from each card because the whole page is about it.
const termsFor = await getPostTerms(posts.map((p) => p.data.id));
const archivePosts = posts.map((post) => {
	const { tags, category } = termsFor(post.data.id);
	return { post, category, tags: tags.filter((t) => t.slug !== term.slug) };
});
---

<Base title={`${term.label} — Tag`} description={term.description ?? `Tulisan dengan tag ${term.label}`}>
	<TermArchive
		eyebrow="Tag"
		title={term.label}
		description={term.description}
		basePath={`/tag/${term.slug}`}
		posts={archivePosts}
		cursor={cursor}
		nextCursor={nextCursor}
	/>
</Base>
