// Cloudflare Workers deployment for the web app.
// Forking this project? Change `name`, the D1/R2 names, `routes` and
// EMDASH_SITE_URL to your own. On the first `pnpm run deploy` Wrangler creates
// the D1 database and R2 bucket if they don't exist yet.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-blog",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-blog-media",
		},
	],
	// EmDash resizes R2 images in the Worker through this binding.
	"images": {
		"binding": "IMAGES",
	},

	// Public origin. EmDash binds passkeys to it, so it must be set BEFORE the
	// production setup wizard runs, and setup must be done on this domain.
	// Secrets (EMDASH_ENCRYPTION_KEY) go in `wrangler secret put`, never here.
	"vars": {
		"EMDASH_SITE_URL": "https://emdash.alfariesh.ai.id",
		// Open /posts/… links in the mobile app (src/lib/app-links.ts). Empty =
		// the verification file is not served. iOS: "<Team ID>.<bundle id>";
		// Android: the package plus the SHA-256 signing-cert fingerprints.
		// Several values are comma-separated. IOS_STORE_ID (numeric App Store
		// ID) adds Safari's Smart App Banner once the app is in the App Store.
		"APP_LINKS_IOS_APP_IDS": "",
		"APP_LINKS_ANDROID_PACKAGE": "",
		"APP_LINKS_ANDROID_SHA256": "",
		"APP_LINKS_IOS_STORE_ID": "",
	},
	// The zone must be active on Cloudflare in the same account; Wrangler
	// creates the DNS record for the custom domain.
	"routes": [
		{
			"pattern": "emdash.alfariesh.ai.id",
			"custom_domain": true,
		},
	],

	// Abuse guard for /api/v1/devices (push registration): requests per client
	// IP, counted per Cloudflare location (src/lib/push-devices.ts). The
	// namespace_id must be unique within your Cloudflare account.
	"ratelimits": [
		{
			"name": "DEVICES_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 },
		},
	],

	// Scheduled publishing + maintenance (handled by `scheduled` in src/worker.ts).
	"triggers": {
		"crons": ["* * * * *"],
	},

	"observability": {
		"enabled": true,
	},
}
