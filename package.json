{
  "name": "blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Blog EmDash: web (Astro + HeroUI) dan mobile (React Native + HeroUI Native)",
  "scripts": {
    "dev": "pnpm --filter @blog/web dev",
    "dev:stop": "pnpm --filter @blog/web exec astro dev stop",
    "build": "pnpm --filter @blog/web build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "deploy:web": "pnpm --filter @blog/web run deploy"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
